# Required for scripts/refresh-brands.ts and app/api/search-brand — the data
# pipeline is two decoupled free-tier calls in sequence (see
# lib/fetch-brand-data.ts): Tavily for search, Gemini (Flash/Flash-Lite) for
# synthesis into the structured schema. Neither requires a card on its free
# tier, but both have real quotas that can be exhausted — see README.md
# "Cost and abuse controls".

# tavily.com — free tier: 1,000 credits/month, no card required.
TAVILY_API_KEY=

# aistudio.google.com — free tier: no card, ~5-15 requests/min,
# ~1,000-1,500 requests/day depending on model.
GEMINI_API_KEY=

# Must be a Flash or Flash-Lite model — those are the only free-tier-eligible
# Gemini models this pipeline is allowed to use. Defaults to gemini-3.6-flash
# if unset. Do NOT point this at a Pro model.
GEMINI_MODEL=

# Optional overrides for the quota-exhaustion safety checks in lib/quota.ts —
# keep these comfortably under Tavily's/Gemini's actual free-tier caps.
TAVILY_MONTHLY_CREDIT_BUDGET=
GEMINI_DAILY_REQUEST_BUDGET=
